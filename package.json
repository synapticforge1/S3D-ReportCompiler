{
  "name": "@jrmarcum/s3d-reportcompiler",
  "version": "1.0.4",
  "description": "Compile a folder of SkyCiv structural design reports into one combined PDF, and prove nothing was lost.",
  "type": "module",
  "private": true,
  "bin": {
    "s3d-reportcompiler": "./main.ts"
  },
  "scripts": {
    "build": "bun main.ts",
    "build:node": "node main.ts",
    "build:deno": "deno run -A main.ts",
    "build:sample": "cd tests && bun ../main.ts",
    "bundle:browser": "bun build ./src/report_core.ts --target=browser --outfile=tests/report_core.browser.js",
    "check": "bun check -p tsconfig.check.json",
    "check:deno": "deno check main.ts src/report_core.ts src/report_runtime.ts",
    "cli:install": "deno install -g -A --force -n s3d-reportcompiler main.ts",
    "cli:install-jsr": "deno install -g -A --force --min-dep-age=0 -n s3d-reportcompiler jsr:@jrmarcum/s3d-reportcompiler/cli",
    "cli:uninstall": "deno uninstall -g s3d-reportcompiler",
    "update-version": "bun scripts/sync-version.ts",
    "surface": "bun scripts/compat.ts surface --write",
    "compat": "bun scripts/compat.ts check",
    "bump": "bun scripts/bump.ts",
    "release": "bun scripts/publish.ts",
    "verify-release": "bun scripts/verify-release.ts",
    "format": "bun fmt main.ts src scripts",
    "format:check": "bun fmt --check main.ts src scripts && bun scripts/check-format-canary.ts",
    "lint": "bunx @biomejs/biome@2.5.15 lint --error-on-warnings && bun scripts/check-lint-canary.ts",
    "runtimes": "bun scripts/check-runtimes.ts",
    "serve": "npx --yes serve ."
  },
  "dependencies": {
    "mathjax-full": "3.2.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "@napi-rs/canvas": "1.0.11"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
