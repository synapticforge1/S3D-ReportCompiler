{
  "name": "@jrmarcum/s3d-reportcompiler",
  "version": "1.1.4",
  "description": "Compile a folder of SkyCiv structural design reports into one combined PDF, and prove nothing was lost.",
  "type": "module",
  "private": true,
  "bin": {
    "s3d-reportcompiler": "./main.ts"
  },
  "scripts": {
    "build": "bun main.ts",
    "build:node": "node main.ts",
    "build:sample": "cd tests && bun ../main.ts",
    "bundle:browser": "bun build ./src/report_core.ts --target=browser --outfile=tests/report_core.browser.js",
    "check": "bun check -p tsconfig.check.json",
    "test": "bun test --timeout 300000 tests/build.test.ts",
    "test:node": "node --test --test-concurrency=1 tests/build.test.ts",
    "cli:install": "bun scripts/npm-build.ts && npm install -g --install-links ./dist",
    "cli:install-published": "npm install -g @synapticforge1/s3d-reportcompiler",
    "cli:uninstall": "npm uninstall -g @synapticforge1/s3d-reportcompiler",
    "update-version": "bun scripts/sync-version.ts",
    "npm:build": "bun scripts/npm-build.ts",
    "npm:prove": "bun scripts/npm-prove.ts",
    "surface": "bun scripts/compat.ts surface --write",
    "compat": "bun scripts/compat.ts check",
    "bump": "bun scripts/bump.ts",
    "release": "bun scripts/publish.ts",
    "verify-release": "bun scripts/verify-release.ts",
    "format": "bun fmt main.ts src scripts tests/build.test.ts",
    "format:check": "bun fmt --check main.ts src scripts tests/build.test.ts && bun scripts/check-format-canary.ts",
    "lint": "bunx @biomejs/biome@2.5.15 lint --error-on-warnings && bun scripts/check-lint-canary.ts",
    "runtimes": "bun scripts/check-runtimes.ts",
    "serve": "npx --yes serve ."
  },
  "dependencies": {
    "mathjax-full": "3.2.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "@napi-rs/canvas": "1.0.11"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
