{
  "name": "@jrmarcum/s3d-reportcompiler",
  "version": "1.0.4",
  "description": "Compile a folder of SkyCiv structural design reports into one combined PDF, and prove nothing was lost.",
  "license": "MIT",
  "exports": {
    ".": "./src/report_core.ts",
    "./cli": "./main.ts",
    "./runtime": "./src/report_runtime.ts"
  },
  "bin": {
    "s3d-reportcompiler": "./main.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "README.md",
      "main.ts",
      "src/*.ts",
      "deno.json"
    ]
  },
  "imports": {
    "mathjax-full/": "npm:mathjax-full@3.2.2/",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "pdfjs-dist/": "npm:pdfjs-dist@6.4.299/"
  },
  "nodeModulesDir": "manual"
}
